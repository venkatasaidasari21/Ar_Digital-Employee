# Copy to `.env` for local development. No variables are required to run the app
# — it works out of the box on the built-in default planner with no keys.

# ---------------------------------------------------------------------------
# Model providers (all optional)
# ---------------------------------------------------------------------------

# Provider selection: default, openai, or gemini. If unset, keys select automatically.
VOXOS_PROVIDER=default

# Server-side keys (never expose these to the browser or commit them).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model and API endpoint overrides (useful for local test stubs).
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------------

# DATABASE_URL — REQUIRED only if the site runs database queries. It drives the
# server-only `~/db` helper (Neon serverless Postgres). Optional for a feature
# build / preview: omitted, the app still builds and serves and the error only
# surfaces if a query actually runs. On a real deploy (`bun run go-live`) this is
# passed through to the live host as a runtime env var.
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Server port (optional / informational)
# ---------------------------------------------------------------------------

# PORT — OPTIONAL. The local and preview server (serve.ts) pins this to 3000
# deliberately and ignores an env override, so a stray value cannot move the
# published preview off its public port. It is listed here for completeness for
# when VoxOS runs server-side on a real host that supplies its own PORT.
# PORT=3000

# ---------------------------------------------------------------------------
# Real-host deployment (VERCEL_TOKEN — REQUIRED only to go live)
# ---------------------------------------------------------------------------

# VERCEL_TOKEN — REQUIRED only when publishing the site live via `bun run go-live`.
# Collected from the owner through the go-live flow and never needed for local
# development or the preview. Keep it secret.
# VERCEL_TOKEN=
